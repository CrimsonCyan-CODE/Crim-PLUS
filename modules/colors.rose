{
  "rose_format": 1,
  "name": "colors",
  "version": "1.1",
  "files": [
    {
      "name": "colors.crim",
      "source": "# colors 1.1 - color tools for Crim+\n# Use it with:   use colors\n# Example:       set c to run rainbow using 120\n#                set color of hero to c\n#                text color is c\n#                say \"Hello!\" in c\n# A color is a name like red or a hex code in quotes like \"#ff8800\". Every instruction here accepts either\n# and gives back a hex code, so you can feed one result into the next.\n# The colors you get back work anywhere Crim+ takes a color: set color of ... to c, change color of ... to c,\n# text color is c, and say \"...\" in c.\n# Unknown color names turn into black (\"#000000\") instead of stopping your program.\n# Helper variables and helper instructions inside this module start with col_ so they won't clash with yours.\n\ninstruction to col_digit_value using ch:\n    set col_digits to split \"0123456789abcdef\" by \"\"\n    set col_i to 0\n    for each col_d in col_digits, do:\n        if col_d is ch, then do:\n            give back col_i\n        end if\n        change col_i by 1\n    end for each\n    give back 0\nend instruction\n\ninstruction to col_hex2 using n:\n    set col_n to round n\n    if col_n < 0, then do:\n        set col_n to 0\n    end if\n    if col_n > 255, then do:\n        set col_n to 255\n    end if\n    set col_digits to split \"0123456789abcdef\" by \"\"\n    set col_hi to floor (col_n / 16)\n    set col_lo to col_n mod 16\n    set col_out to col_digits[col_hi], then col_digits[col_lo]\n    give back col_out\nend instruction\n\ninstruction to to_hex using color:\n    set col_text to trim of color\n    set col_text to lowercase of col_text\n    if col_text starts with \"#\", then do:\n        if length of col_text is 7, then do:\n            give back col_text\n        end if\n        give back \"#000000\"\n    end if\n    if col_text is \"purple\", then do:\n        give back \"#a020f0\"\n    end if\n    if col_text is \"red\", then do:\n        give back \"#ff0000\"\n    end if\n    if col_text is \"green\", then do:\n        give back \"#00c800\"\n    end if\n    if col_text is \"blue\", then do:\n        give back \"#1e64ff\"\n    end if\n    if col_text is \"yellow\", then do:\n        give back \"#ffe600\"\n    end if\n    if col_text is \"orange\", then do:\n        give back \"#ff8c00\"\n    end if\n    if col_text is \"pink\", then do:\n        give back \"#ff69b4\"\n    end if\n    if col_text is \"white\", then do:\n        give back \"#ffffff\"\n    end if\n    if col_text is \"black\", then do:\n        give back \"#000000\"\n    end if\n    if col_text is \"gray\", then do:\n        give back \"#969696\"\n    end if\n    if col_text is \"grey\", then do:\n        give back \"#969696\"\n    end if\n    if col_text is \"cyan\", then do:\n        give back \"#00dcdc\"\n    end if\n    if col_text is \"magenta\", then do:\n        give back \"#ff00ff\"\n    end if\n    if col_text is \"brown\", then do:\n        give back \"#8c501e\"\n    end if\n    if col_text is \"teal\", then do:\n        give back \"#008c8c\"\n    end if\n    if col_text is \"gold\", then do:\n        give back \"#ffc800\"\n    end if\n    if col_text is \"navy\", then do:\n        give back \"#000080\"\n    end if\n    if col_text is \"crimson\", then do:\n        give back \"#dc143c\"\n    end if\n    if col_text is \"maroon\", then do:\n        give back \"#800000\"\n    end if\n    if col_text is \"darkred\", then do:\n        give back \"#8b0000\"\n    end if\n    if col_text is \"coral\", then do:\n        give back \"#ff7f50\"\n    end if\n    if col_text is \"salmon\", then do:\n        give back \"#fa8072\"\n    end if\n    if col_text is \"rose\", then do:\n        give back \"#ff007f\"\n    end if\n    if col_text is \"peach\", then do:\n        give back \"#ffdab9\"\n    end if\n    if col_text is \"khaki\", then do:\n        give back \"#f0e68c\"\n    end if\n    if col_text is \"beige\", then do:\n        give back \"#f5f5dc\"\n    end if\n    if col_text is \"sand\", then do:\n        give back \"#c2b280\"\n    end if\n    if col_text is \"chocolate\", then do:\n        give back \"#d2691e\"\n    end if\n    if col_text is \"lime\", then do:\n        give back \"#32ff32\"\n    end if\n    if col_text is \"mint\", then do:\n        give back \"#98ff98\"\n    end if\n    if col_text is \"lightgreen\", then do:\n        give back \"#90ee90\"\n    end if\n    if col_text is \"darkgreen\", then do:\n        give back \"#006400\"\n    end if\n    if col_text is \"olive\", then do:\n        give back \"#808000\"\n    end if\n    if col_text is \"skyblue\", then do:\n        give back \"#87ceeb\"\n    end if\n    if col_text is \"lightblue\", then do:\n        give back \"#add8e6\"\n    end if\n    if col_text is \"darkblue\", then do:\n        give back \"#00008b\"\n    end if\n    if col_text is \"turquoise\", then do:\n        give back \"#40e0d0\"\n    end if\n    if col_text is \"indigo\", then do:\n        give back \"#4b0082\"\n    end if\n    if col_text is \"violet\", then do:\n        give back \"#ee82ee\"\n    end if\n    if col_text is \"lavender\", then do:\n        give back \"#e6e6fa\"\n    end if\n    if col_text is \"plum\", then do:\n        give back \"#dda0dd\"\n    end if\n    if col_text is \"silver\", then do:\n        give back \"#c0c0c0\"\n    end if\n    if col_text is \"lightgray\", then do:\n        give back \"#c8c8c8\"\n    end if\n    if col_text is \"lightgrey\", then do:\n        give back \"#c8c8c8\"\n    end if\n    if col_text is \"darkgray\", then do:\n        give back \"#5a5a5a\"\n    end if\n    if col_text is \"darkgrey\", then do:\n        give back \"#5a5a5a\"\n    end if\n    give back \"#000000\"\nend instruction\n\ninstruction to col_channel using code and which:\n    set col_hex to run to_hex using code\n    set col_chars to split col_hex by \"\"\n    set col_at to 1 + which * 2\n    set col_next to col_at + 1\n    set col_hi to run col_digit_value using col_chars[col_at]\n    set col_lo to run col_digit_value using col_chars[col_next]\n    give back col_hi * 16 + col_lo\nend instruction\n\ninstruction to red_of using color:\n    give back run col_channel using color and 0\nend instruction\n\ninstruction to green_of using color:\n    give back run col_channel using color and 1\nend instruction\n\ninstruction to blue_of using color:\n    give back run col_channel using color and 2\nend instruction\n\ninstruction to rgb using red and green and blue:\n    set col_r to run col_hex2 using red\n    set col_g to run col_hex2 using green\n    set col_b to run col_hex2 using blue\n    set col_out to \"#\", then col_r, then col_g, then col_b\n    give back col_out\nend instruction\n\ninstruction to hsv using hue and saturation and brightness_level:\n    set col_h to hue mod 360\n    if col_h < 0, then do:\n        set col_h to col_h + 360\n    end if\n    set col_s to saturation / 100\n    set col_v to brightness_level / 100\n    if col_s < 0, then do:\n        set col_s to 0\n    end if\n    if col_s > 1, then do:\n        set col_s to 1\n    end if\n    if col_v < 0, then do:\n        set col_v to 0\n    end if\n    if col_v > 1, then do:\n        set col_v to 1\n    end if\n    set col_c to col_v * col_s\n    set col_sector to col_h / 60\n    set col_k to col_sector mod 2\n    set col_x to col_c * (1 - abs (col_k - 1))\n    set col_m to col_v - col_c\n    set col_which to floor col_sector\n    set col_r to 0\n    set col_g to 0\n    set col_b to 0\n    if col_which is 0, then do:\n        set col_r to col_c\n        set col_g to col_x\n    but if col_which is 1, then do:\n        set col_r to col_x\n        set col_g to col_c\n    but if col_which is 2, then do:\n        set col_g to col_c\n        set col_b to col_x\n    but if col_which is 3, then do:\n        set col_g to col_x\n        set col_b to col_c\n    but if col_which is 4, then do:\n        set col_r to col_x\n        set col_b to col_c\n    anything else do:\n        set col_r to col_c\n        set col_b to col_x\n    end if\n    give back run rgb using (col_r + col_m) * 255 and (col_g + col_m) * 255 and (col_b + col_m) * 255\nend instruction\n\ninstruction to mix_colors using first and second and amount:\n    set col_ra to run red_of using first\n    set col_ga to run green_of using first\n    set col_ba to run blue_of using first\n    set col_rb to run red_of using second\n    set col_gb to run green_of using second\n    set col_bb to run blue_of using second\n    set col_t to amount / 100\n    if col_t < 0, then do:\n        set col_t to 0\n    end if\n    if col_t > 1, then do:\n        set col_t to 1\n    end if\n    set col_r to col_ra + (col_rb - col_ra) * col_t\n    set col_g to col_ga + (col_gb - col_ga) * col_t\n    set col_b to col_ba + (col_bb - col_ba) * col_t\n    give back run rgb using col_r and col_g and col_b\nend instruction\n\ninstruction to lighten using color and amount:\n    give back run mix_colors using color and \"#ffffff\" and amount\nend instruction\n\ninstruction to darken using color and amount:\n    give back run mix_colors using color and \"#000000\" and amount\nend instruction\n\ninstruction to invert_color using color:\n    set col_r to run red_of using color\n    set col_g to run green_of using color\n    set col_b to run blue_of using color\n    give back run rgb using 255 - col_r and 255 - col_g and 255 - col_b\nend instruction\n\ninstruction to brightness using color:\n    set col_r to run red_of using color\n    set col_g to run green_of using color\n    set col_b to run blue_of using color\n    give back round (col_r * 0.299 + col_g * 0.587 + col_b * 0.114)\nend instruction\n\ninstruction to grayscale using color:\n    set col_level to run brightness using color\n    give back run rgb using col_level and col_level and col_level\nend instruction\n\ninstruction to contrast_color using color:\n    set col_level to run brightness using color\n    if col_level > 140, then do:\n        give back \"#000000\"\n    end if\n    give back \"#ffffff\"\nend instruction\n\ninstruction to rainbow using degrees:\n    give back run hsv using degrees and 100 and 100\nend instruction\n\ninstruction to gradient using first and second and step and steps:\n    if steps <= 1, then do:\n        give back run to_hex using first\n    end if\n    give back run mix_colors using first and second and step / (steps - 1) * 100\nend instruction\n\ninstruction to random_color:\n    set col_r to random number between 0 and 255\n    set col_g to random number between 0 and 255\n    set col_b to random number between 0 and 255\n    give back run rgb using col_r and col_g and col_b\nend instruction\n\ninstruction to random_bright_color:\n    set col_h to random number between 0 and 359\n    give back run hsv using col_h and 85 and 100\nend instruction\n\ninstruction to health_color using value and maximum:\n    if maximum <= 0, then do:\n        give back \"red\"\n    end if\n    set col_fraction to value / maximum\n    if col_fraction >= 0.6, then do:\n        give back \"green\"\n    but if col_fraction >= 0.3, then do:\n        give back \"yellow\"\n    end if\n    give back \"red\"\nend instruction\n"
    }
  ]
}
