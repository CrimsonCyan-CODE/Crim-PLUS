  "rose_format": 1,
  "name": "physics",
  "version": "1.6",
  "files": [
    {
      "name": "physics.crim",
      "source": "# physics 1.6 - frame-based 2D physics for Crim+\n# Use it with: use physics\n#\n# State variables start with ph_.\n# You must call update_physics and move_body every frame in an 'always' block.\n\nset ph_x_velocity to 0\nset ph_y_velocity to 0\nset ph_x_acceleration to 0\nset ph_y_acceleration to 0\nset ph_mass to 1.0\nset ph_drag to 0.0\nset ph_restitution to 0.5\nset ph_friction to 0.0\nset ph_gravity_scale to 1.0\nset ph_terminal_velocity to 30.0\nset ph_is_grounded to 0\n\n# --- SETUP (with validation) ---\n\ninstruction to set_mass using m:\n    if m <= 0, then do:\n        set ph_mass to 1.0\n    anything else do:\n        set ph_mass to m\n    end if\nend instruction\n\ninstruction to set_bounciness using r:\n    if r < 0, then do:\n        set ph_restitution to 0\n    but if r > 1, then do:\n        set ph_restitution to 1\n    anything else do:\n        set ph_restitution to r\n    end if\nend instruction\n\ninstruction to set_friction using f:\n    if f < 0, then do:\n        set ph_friction to 0\n    anything else do:\n        set ph_friction to f\n    end if\nend instruction\n\ninstruction to set_drag using d:\n    if d < 0, then do:\n        set ph_drag to 0\n    but if d > 1, then do:\n        set ph_drag to 1\n    anything else do:\n        set ph_drag to d\n    end if\nend instruction\n\ninstruction to set_gravity_scale using g:\n    set ph_gravity_scale to g\nend instruction\n\ninstruction to set_terminal_velocity using v:\n    if v <= 0, then do:\n        set ph_terminal_velocity to 30.0\n    anything else do:\n        set ph_terminal_velocity to v\n    end if\nend instruction\n\n# --- FORCES ---\n\ninstruction to apply_force using fx and fy:\n    set ph_x_acceleration to ph_x_acceleration + (fx / ph_mass)\n    set ph_y_acceleration to ph_y_acceleration + (fy / ph_mass)\nend instruction\n\ninstruction to apply_impulse using ix and iy:\n    set ph_x_velocity to ph_x_velocity + (ix / ph_mass)\n    set ph_y_velocity to ph_y_velocity + (iy / ph_mass)\nend instruction\n\ninstruction to add_velocity using vx and vy:\n    set ph_x_velocity to ph_x_velocity + vx\n    set ph_y_velocity to ph_y_velocity + vy\nend instruction\n\n# --- SIMULATION ---\n\ninstruction to update_physics using global_gravity:\n    set ph_y_acceleration to ph_y_acceleration + (global_gravity * ph_gravity_scale)\n    \n    set ph_x_velocity to ph_x_velocity + ph_x_acceleration\n    set ph_y_velocity to ph_y_velocity + ph_y_acceleration\n    \n    set ph_x_acceleration to 0\n    set ph_y_acceleration to 0\n    \n    if ph_drag > 0, then do:\n        set ph_x_velocity to ph_x_velocity * (1.0 - ph_drag)\n        set ph_y_velocity to ph_y_velocity * (1.0 - ph_drag)\n    end if\n    \n    if ph_y_velocity > ph_terminal_velocity, then do:\n        set ph_y_velocity to ph_terminal_velocity\n    but if ph_y_velocity < (0 - ph_terminal_velocity), then do:\n        set ph_y_velocity to (0 - ph_terminal_velocity)\n    end if\n    \n    if ph_is_grounded is 1, then do:\n        if ph_x_velocity > 0, then do:\n            if ph_friction >= ph_x_velocity, then do:\n                set ph_x_velocity to 0\n            anything else do:\n                set ph_x_velocity to ph_x_velocity - ph_friction\n            end if\n        but if ph_x_velocity < 0, then do:\n            if ph_friction >= (0 - ph_x_velocity), then do:\n                set ph_x_velocity to 0\n            anything else do:\n                set ph_x_velocity to ph_x_velocity + ph_friction\n            end if\n        end if\n    end if\nend instruction\n\ninstruction to move_body using obj:\n    if ph_x_velocity > 0, then do:\n        move obj right ph_x_velocity pixels\n    but if ph_x_velocity < 0, then do:\n        set ph_x_velocity to 0 - ph_x_velocity\n        move obj left ph_x_velocity pixels\n        set ph_x_velocity to 0 - ph_x_velocity\n    end if\n    \n    if ph_y_velocity > 0, then do:\n        move obj down ph_y_velocity pixels\n    but if ph_y_velocity < 0, then do:\n        set ph_y_velocity to 0 - ph_y_velocity\n        move obj up ph_y_velocity pixels\n        set ph_y_velocity to 0 - ph_y_velocity\n    end if\nend instruction\n\n# --- COLLISION RESOLUTION ---\n\ninstruction to resolve_floor_collision using obj and floor:\n    if obj is touching floor, then do:\n        if ph_y_velocity > 0, then do:\n            set ph_target_y to (y of floor) - (height of obj)\n            set ph_current_y to y of obj\n            set ph_correction to ph_current_y - ph_target_y\n            \n            if ph_correction > 0, then do:\n                move obj up ph_correction pixels\n            end if\n            \n            set ph_y_velocity to (0 - ph_y_velocity) * ph_restitution\n            \n            if ph_y_velocity < 2.0 and ph_y_velocity > -2.0, then do:\n                set ph_y_velocity to 0\n                set ph_is_grounded to 1\n            end if\n        anything else do:\n            set ph_is_grounded to 1\n        end if\n    anything else do:\n        set ph_is_grounded to 0\n    end if\nend instruction\n\ninstruction to resolve_wall_collision using obj and wall:\n    if obj is touching wall, then do:\n        set ph_obj_left to x of obj\n        set ph_obj_right to (x of obj) + (width of obj)\n        set ph_wall_left to x of wall\n        set ph_wall_right to (x of wall) + (width of wall)\n        \n        if ph_x_velocity > 0, then do:\n            set ph_correction to ph_obj_right - ph_wall_left\n            if ph_correction > 0, then do:\n                move obj left ph_correction pixels\n            end if\n            set ph_x_velocity to 0\n            \n        but if ph_x_velocity < 0, then do:\n            set ph_correction to ph_wall_right - ph_obj_left\n            if ph_correction > 0, then do:\n                move obj right ph_correction pixels\n            end if\n            set ph_x_velocity to 0\n            \n        anything else do:\n            set ph_overlap_right to ph_obj_right - ph_wall_left\n            set ph_overlap_left to ph_wall_right - ph_obj_left\n            \n            if ph_overlap_right < ph_overlap_left, then do:\n                move obj left ph_overlap_right pixels\n            anything else do:\n                move obj right ph_overlap_left pixels\n            end if\n        end if\n    end if\nend instruction\n\n# --- GETTERS ---\n\ninstruction to get_speed:\n    set ph_speed_sq to (ph_x_velocity * ph_x_velocity) + (ph_y_velocity * ph_y_velocity)\n    give back sqrt ph_speed_sq\nend instruction\n\ninstruction to get_x_velocity:\n    give back ph_x_velocity\nend instruction\n\ninstruction to get_y_velocity:\n    give back ph_y_velocity\nend instruction\n\ninstruction to is_grounded:\n    give back ph_is_grounded\nend instruction\n\ninstruction to reset_physics:\n    set ph_x_velocity to 0\n    set ph_y_velocity to 0\n    set ph_x_acceleration to 0\n    set ph_y_acceleration to 0\n    set ph_is_grounded to 0\nend instruction\n"
    }
  ]
}
