{
  "rose_format": 1,
  "name": "texttools",
  "version": "1.0",
  "files": [
    {
      "name": "texttools.crim",
      "source": "# texttools 1.0 - extra text tools for Crim+\n# Use it with:   this script uses: texttools\n# Example:       say run reverse_text using \"hello\"\n# (Crim+ already has: length of, uppercase of, lowercase of, trim of, split, join,\n#  contains / starts with / ends with. This module adds the rest.)\n# Positions count from 0, like lists do: the first letter is position 0.\n# Numbers work too: run pad_left using 7 and 3 and \"0\" gives 007.\n# Each instruction's helper variables have their own short prefix (rv_, cp_, ...)\n# so they won't clash with yours or with each other.\n\ninstruction to reverse_text using phrase:\n    set rv_chars to split phrase by \"\"\n    set rv_i to length of rv_chars\n    set rv_out to \"\"\n    as long as rv_i > 0, do:\n        set rv_i to rv_i - 1\n        set rv_out to rv_out, then rv_chars[rv_i]\n    end while\n    give back rv_out\nend instruction\n\ninstruction to repeat_text using phrase and count:\n    set rp_out to \"\"\n    set rp_i to 0\n    as long as rp_i < count, do:\n        set rp_out to rp_out, then phrase\n        set rp_i to rp_i + 1\n    end while\n    give back rp_out\nend instruction\n\ninstruction to replace_text using phrase and old and new:\n    if length of old is 0, then do:\n        give back phrase\n    end if\n    set rt_parts to split phrase by old\n    give back join rt_parts with new\nend instruction\n\ninstruction to remove_spaces using phrase:\n    set rs_parts to split phrase by \" \"\n    give back join rs_parts with \"\"\nend instruction\n\ninstruction to count_of using phrase and piece:\n    if length of piece is 0, then do:\n        give back 0\n    end if\n    set co_parts to split phrase by piece\n    set co_n to length of co_parts\n    give back co_n - 1\nend instruction\n\ninstruction to substring using phrase and start and amount:\n    set sb_chars to split phrase by \"\"\n    set sb_len to length of sb_chars\n    set sb_out to \"\"\n    set sb_i to start\n    set sb_end to start + amount\n    as long as sb_i < sb_end, do:\n        if sb_i >= 0 and sb_i < sb_len, then do:\n            set sb_out to sb_out, then sb_chars[sb_i]\n        end if\n        set sb_i to sb_i + 1\n    end while\n    give back sb_out\nend instruction\n\ninstruction to left_text using phrase and amount:\n    give back run substring using phrase and 0 and amount\nend instruction\n\ninstruction to right_text using phrase and amount:\n    set rg_len to length of phrase\n    if amount >= rg_len, then do:\n        give back phrase\n    end if\n    give back run substring using phrase and rg_len - amount and amount\nend instruction\n\ninstruction to capitalize using phrase:\n    set cp_chars to split phrase by \"\"\n    if length of cp_chars is 0, then do:\n        give back \"\"\n    end if\n    set cp_first to cp_chars[0]\n    remove item 0 from cp_chars\n    set cp_rest to join cp_chars with \"\"\n    set cp_out to uppercase of cp_first, then lowercase of cp_rest\n    give back cp_out\nend instruction\n\ninstruction to title_case using phrase:\n    set tc_words to split phrase by \" \"\n    set tc_n to length of tc_words\n    set tc_out to \"\"\n    set tc_i to 0\n    as long as tc_i < tc_n, do:\n        set tc_w to run capitalize using tc_words[tc_i]\n        if tc_i > 0, then do:\n            set tc_out to tc_out, then \" \"\n        end if\n        set tc_out to tc_out, then tc_w\n        set tc_i to tc_i + 1\n    end while\n    give back tc_out\nend instruction\n\ninstruction to pad_left using phrase and total_width and fill:\n    set pl_text to phrase, then \"\"\n    set pl_len to length of pl_text\n    set pl_gap to total_width - pl_len\n    if pl_gap <= 0, then do:\n        give back pl_text\n    end if\n    set pl_pad to run repeat_text using fill and pl_gap\n    set pl_out to pl_pad, then pl_text\n    give back pl_out\nend instruction\n\ninstruction to pad_right using phrase and total_width and fill:\n    set pr_text to phrase, then \"\"\n    set pr_len to length of pr_text\n    set pr_gap to total_width - pr_len\n    if pr_gap <= 0, then do:\n        give back pr_text\n    end if\n    set pr_pad to run repeat_text using fill and pr_gap\n    set pr_out to pr_text, then pr_pad\n    give back pr_out\nend instruction\n\ninstruction to center_text using phrase and total_width and fill:\n    set ct_text to phrase, then \"\"\n    set ct_len to length of ct_text\n    set ct_gap to total_width - ct_len\n    if ct_gap <= 0, then do:\n        give back ct_text\n    end if\n    set ct_left to floor (ct_gap / 2)\n    set ct_right to ct_gap - ct_left\n    set ct_lpad to run repeat_text using fill and ct_left\n    set ct_rpad to run repeat_text using fill and ct_right\n    set ct_out to ct_lpad, then ct_text, then ct_rpad\n    give back ct_out\nend instruction\n\ninstruction to truncate_text using phrase and max_length:\n    set tr_text to phrase, then \"\"\n    if length of tr_text <= max_length, then do:\n        give back tr_text\n    end if\n    if max_length <= 3, then do:\n        give back run left_text using tr_text and max_length\n    end if\n    set tr_cut to run left_text using tr_text and max_length - 3\n    set tr_out to tr_cut, then \"...\"\n    give back tr_out\nend instruction\n\ninstruction to word_count using phrase:\n    set wc_clean to trim of phrase\n    if length of wc_clean is 0, then do:\n        give back 0\n    end if\n    set wc_words to split wc_clean by \" \"\n    set wc_total to 0\n    for each wc_w in wc_words, do:\n        if length of wc_w > 0, then do:\n            set wc_total to wc_total + 1\n        end if\n    end for each\n    give back wc_total\nend instruction\n\ninstruction to is_palindrome using phrase:\n    set ip_clean to run remove_spaces using lowercase of phrase\n    set ip_back to run reverse_text using ip_clean\n    if ip_clean is ip_back, then do:\n        give back 1\n    end if\n    give back 0\nend instruction\n\ninstruction to with_commas using n:\n    set wm_text to n, then \"\"\n    set wm_parts to split wm_text by \".\"\n    set wm_whole to wm_parts[0]\n    set wm_decimals to \"\"\n    if length of wm_parts > 1, then do:\n        set wm_decimals to \".\", then wm_parts[1]\n    end if\n    set wm_chars to split wm_whole by \"\"\n    set wm_sign to \"\"\n    if wm_chars[0] is \"-\", then do:\n        set wm_sign to \"-\"\n        remove item 0 from wm_chars\n    end if\n    set wm_count to length of wm_chars\n    set wm_out to \"\"\n    set wm_i to 0\n    as long as wm_i < wm_count, do:\n        set wm_left to wm_count - wm_i\n        if wm_i > 0 and wm_left mod 3 is 0, then do:\n            set wm_out to wm_out, then \",\"\n        end if\n        set wm_out to wm_out, then wm_chars[wm_i]\n        set wm_i to wm_i + 1\n    end while\n    set wm_result to wm_sign, then wm_out, then wm_decimals\n    give back wm_result\nend instruction\n"
    }
  ]
}
