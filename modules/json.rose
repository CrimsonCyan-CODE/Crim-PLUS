{
  "rose_format": 1,
  "name": "json",
  "version": "1.5.2",
  "files": [
    {
      "name": "json.crim",
      "source": "# json 1.5.2 - Robust JSON parser and encoder for Crim+\n# Supports nested objects, arrays, strings, numbers, booleans, null and escapes.\n# Use it with: use json\n#\n# Note: Full U+0001-U+001F control character handling requires a native\n# ord()/chr() function in the Crim+ interpreter. Currently, common controls\n# (\\n, \\r, \\t, \\b, \\f, \\0, \\a, \\v, \\e) are handled.\n#\n# Internal representations (1-based indexing):\n# Objects: [\"__obj__\", key, value, ...]\n# Arrays:  [\"__arr__\", value, ...]\n# Booleans: [\"__bool__\", 1] or [\"__bool__\", 0]\n# Null: [\"__null__\"]\n# Strings: [\"__str__\", segments]\n# Text segment: [\"__text__\", text]\n# Unicode segment: [\"__u16__\", four_hex_digits]\n#\n# Helper variables start with js_.\n\nset js_pos to 0\nset js_text to \"\"\n\n# --------------------------------------------------\n# ERRORS\n# --------------------------------------------------\n\ninstruction to js_fail using msg:\n    say \"JSON ERROR: \", then msg\n    stop\nend instruction\n\n# --------------------------------------------------\n# CHARACTER HELPERS\n# --------------------------------------------------\n\ninstruction to js_peek:\n    if js_pos > length of js_text, then do:\n        give back \"\"\n    end if\n    give back substring of js_text from js_pos to js_pos\nend instruction\n\ninstruction to js_is_digit using char:\n    if char is \"0\" or char is \"1\" or char is \"2\" or char is \"3\" or char is \"4\" or char is \"5\" or char is \"6\" or char is \"7\" or char is \"8\" or char is \"9\", then do:\n        give back 1\n    end if\n    give back 0\nend instruction\n\ninstruction to js_is_nonzero_digit using char:\n    if char is \"1\" or char is \"2\" or char is \"3\" or char is \"4\" or char is \"5\" or char is \"6\" or char is \"7\" or char is \"8\" or char is \"9\", then do:\n        give back 1\n    end if\n    give back 0\nend instruction\n\ninstruction to js_hex_digit using char:\n    if call js_is_digit with char is 1, then do:\n        give back 1\n    end if\n\n    if char is \"a\" or char is \"b\" or char is \"c\" or char is \"d\" or char is \"e\" or char is \"f\" or char is \"A\" or char is \"B\" or char is \"C\" or char is \"D\" or char is \"E\" or char is \"F\", then do:\n        give back 1\n    end if\n\n    give back 0\nend instruction\n\ninstruction to js_skip_whitespace:\n    forever:\n        set js_char to js_peek\n\n        if js_char is \" \" or js_char is \"\\n\" or js_char is \"\\t\" or js_char is \"\\r\", then do:\n            change js_pos by 1\n        anything else do:\n            stop\n        end if\n\n        if js_pos > length of js_text, then do:\n            stop\n        end if\n    end forever\nend instruction\n\n# --------------------------------------------------\n# STRING PARSING\n# --------------------------------------------------\n\ninstruction to js_parse_string:\n    change js_pos by 1\n\n    set js_segments to []\n    set js_part to \"\"\n    set js_is_escaped to 0\n\n    as long as js_pos <= length of js_text, do:\n        set js_char to js_peek\n\n        if js_is_escaped is 1, then do:\n            if js_char is \"n\", then do:\n                set js_part to js_part, then \"\\n\"\n            but if js_char is \"t\", then do:\n                set js_part to js_part, then \"\\t\"\n            but if js_char is \"r\", then do:\n                set js_part to js_part, then \"\\r\"\n            but if js_char is \"b\", then do:\n                set js_part to js_part, then \"\\b\"\n            but if js_char is \"f\", then do:\n                set js_part to js_part, then \"\\f\"\n            but if js_char is \"/\", then do:\n                set js_part to js_part, then \"/\"\n            but if js_char is \"\\\"\", then do:\n                set js_part to js_part, then \"\\\"\"\n            but if js_char is \"\\\\\", then do:\n                set js_part to js_part, then \"\\\\\"\n            but if js_char is \"u\", then do:\n                if length of js_part > 0, then do:\n                    add [\"__text__\", js_part] to js_segments\n                    set js_part to \"\"\n                end if\n\n                set js_unicode to \"\"\n                change js_pos by 1\n\n                repeat 4:\n                    if js_pos > length of js_text, then do:\n                        call js_fail with \"Incomplete Unicode escape\"\n                    end if\n\n                    set js_digit to js_peek\n\n                    if call js_hex_digit with js_digit is 0, then do:\n                        call js_fail with \"Invalid Unicode escape\"\n                    end if\n\n                    set js_unicode to js_unicode, then js_digit\n                    change js_pos by 1\n                end repeat\n\n                add [\"__u16__\", js_unicode] to js_segments\n                change js_pos by -1\n            anything else do:\n                call js_fail with \"Invalid escape sequence in JSON string\"\n            end if\n\n            set js_is_escaped to 0\n\n        but if js_char is \"\\\\\", then do:\n            set js_is_escaped to 1\n\n        but if js_char is \"\\\"\", then do:\n            if length of js_part > 0 or length of js_segments is 0, then do:\n                add [\"__text__\", js_part] to js_segments\n            end if\n\n            change js_pos by 1\n            give back [\"__str__\", js_segments]\n\n        anything else do:\n            if js_char is \"\\n\" or js_char is \"\\r\" or js_char is \"\\t\" or js_char is \"\\b\" or js_char is \"\\f\" or js_char is \"\\0\" or js_char is \"\\a\" or js_char is \"\\v\" or js_char is \"\\e\", then do:\n                call js_fail with \"Unescaped control character in JSON string\"\n            end if\n\n            set js_part to js_part, then js_char\n        end if\n\n        change js_pos by 1\n    end as long as\n\n    if js_is_escaped is 1, then do:\n        call js_fail with \"Incomplete escape sequence\"\n    end if\n\n    call js_fail with \"Unterminated string in JSON\"\nend instruction\n\n# --------------------------------------------------\n# NUMBER VALIDATION\n# --------------------------------------------------\n\ninstruction to js_validate_number using raw:\n    set js_nlen to length of raw\n    set js_i to 1\n\n    if js_nlen is 0, then do:\n        call js_fail with \"Invalid JSON number\"\n    end if\n\n    if substring of raw from js_i to js_i is \"-\", then do:\n        change js_i by 1\n    end if\n\n    if js_i > js_nlen, then do:\n        call js_fail with \"Invalid JSON number\"\n    end if\n\n    set js_char to substring of raw from js_i to js_i\n\n    if js_char is \"0\", then do:\n        change js_i by 1\n\n        if js_i <= js_nlen, then do:\n            set js_char to substring of raw from js_i to js_i\n            if call js_is_digit with js_char is 1, then do:\n                call js_fail with \"Leading zero in JSON number\"\n            end if\n        end if\n    but if call js_is_nonzero_digit with js_char is 1, then do:\n        change js_i by 1\n\n        forever:\n            if js_i > js_nlen, then do:\n                stop\n            end if\n\n            set js_char to substring of raw from js_i to js_i\n\n            if call js_is_digit with js_char is 1, then do:\n                change js_i by 1\n            anything else do:\n                stop\n            end if\n        end forever\n    anything else do:\n        call js_fail with \"Invalid integer part in JSON number\"\n    end if\n\n    if js_i <= js_nlen, then do:\n        set js_char to substring of raw from js_i to js_i\n\n        if js_char is \".\", then do:\n            change js_i by 1\n\n            if js_i > js_nlen, then do:\n                call js_fail with \"Missing digits after decimal point\"\n            end if\n\n            set js_char to substring of raw from js_i to js_i\n\n            if call js_is_digit with js_char is 0, then do:\n                call js_fail with \"Missing digits after decimal point\"\n            end if\n\n            forever:\n                if js_i > js_nlen, then do:\n                    stop\n                end if\n\n                set js_char to substring of raw from js_i to js_i\n\n                if call js_is_digit with js_char is 1, then do:\n                    change js_i by 1\n                anything else do:\n                    stop\n                end if\n            end forever\n        end if\n    end if\n\n    if js_i <= js_nlen, then do:\n        set js_char to substring of raw from js_i to js_i\n\n        if js_char is \"e\" or js_char is \"E\", then do:\n            change js_i by 1\n\n            if js_i <= js_nlen, then do:\n                set js_char to substring of raw from js_i to js_i\n\n                if js_char is \"+\" or js_char is \"-\", then do:\n                    change js_i by 1\n                end if\n            end if\n\n            if js_i > js_nlen, then do:\n                call js_fail with \"Missing exponent digits\"\n            end if\n\n            set js_char to substring of raw from js_i to js_i\n\n            if call js_is_digit with js_char is 0, then do:\n                call js_fail with \"Missing exponent digits\"\n            end if\n\n            forever:\n                if js_i > js_nlen, then do:\n                    stop\n                end if\n\n                set js_char to substring of raw from js_i to js_i\n\n                if call js_is_digit with js_char is 1, then do:\n                    change js_i by 1\n                anything else do:\n                    stop\n                end if\n            end forever\n        end if\n    end if\n\n    if js_i is not js_nlen + 1, then do:\n        call js_fail with \"Invalid character in JSON number\"\n    end if\n\n    give back 1\nend instruction\n\n# --------------------------------------------------\n# VALUE PARSING\n# --------------------------------------------------\n\ninstruction to js_parse_value:\n    call js_skip_whitespace\n\n    if js_pos > length of js_text, then do:\n        call js_fail with \"Unexpected end of JSON\"\n    end if\n\n    set js_char to js_peek\n\n    if js_char is \"{\", then do:\n        give back call js_parse_object\n    end if\n\n    if js_char is \"[\", then do:\n        give back call js_parse_array\n    end if\n\n    if js_char is \"\\\"\", then do:\n        give back call js_parse_string\n    end if\n\n    set js_raw to \"\"\n\n    as long as js_pos <= length of js_text, do:\n        set js_char to js_peek\n\n        if js_char is \",\" or js_char is \"}\" or js_char is \"]\" or js_char is \" \" or js_char is \"\\n\" or js_char is \"\\t\" or js_char is \"\\r\", then do:\n            stop\n        end if\n\n        set js_raw to js_raw, then js_char\n        change js_pos by 1\n    end as long as\n\n    if js_raw is \"true\", then do:\n        give back [\"__bool__\", 1]\n    end if\n\n    if js_raw is \"false\", then do:\n        give back [\"__bool__\", 0]\n    end if\n\n    if js_raw is \"null\", then do:\n        give back [\"__null__\"]\n    end if\n\n    call js_validate_number with js_raw\n    give back js_raw + 0\nend instruction\n\n# --------------------------------------------------\n# OBJECT PARSING\n# --------------------------------------------------\n\ninstruction to js_parse_object:\n    change js_pos by 1\n    set js_obj to [\"__obj__\"]\n\n    call js_skip_whitespace\n\n    if js_peek is \"}\", then do:\n        change js_pos by 1\n        give back js_obj\n    end if\n\n    forever:\n        call js_skip_whitespace\n\n        if js_peek is not \"\\\"\", then do:\n            call js_fail with \"Expected string key in JSON object\"\n        end if\n\n        set js_key to call js_parse_string\n\n        call js_skip_whitespace\n\n        if js_peek is not \":\", then do:\n            call js_fail with \"Expected colon after object key\"\n        end if\n\n        change js_pos by 1\n\n        set js_val to call js_parse_value\n\n        add js_key to js_obj\n        add js_val to js_obj\n\n        call js_skip_whitespace\n\n        if js_peek is \",\", then do:\n            change js_pos by 1\n            call js_skip_whitespace\n\n            if js_peek is \"}\", then do:\n                call js_fail with \"Trailing comma in JSON object\"\n            end if\n\n        but if js_peek is \"}\", then do:\n            change js_pos by 1\n            give back js_obj\n\n        anything else do:\n            call js_fail with \"Expected comma or closing brace\"\n        end if\n    end forever\nend instruction\n\n# --------------------------------------------------\n# ARRAY PARSING\n# --------------------------------------------------\n\ninstruction to js_parse_array:\n    change js_pos by 1\n    set js_arr to [\"__arr__\"]\n\n    call js_skip_whitespace\n\n    if js_peek is \"]\", then do:\n        change js_pos by 1\n        give back js_arr\n    end if\n\n    forever:\n        set js_val to call js_parse_value\n        add js_val to js_arr\n\n        call js_skip_whitespace\n\n        if js_peek is \",\", then do:\n            change js_pos by 1\n            call js_skip_whitespace\n\n            if js_peek is \"]\", then do:\n                call js_fail with \"Trailing comma in JSON array\"\n            end if\n\n        but if js_peek is \"]\", then do:\n            change js_pos by 1\n            give back js_arr\n\n        anything else do:\n            call js_fail with \"Expected comma or closing bracket\"\n        end if\n    end forever\nend instruction\n\n# --------------------------------------------------\n# STRING ENCODING (1-based)\n# --------------------------------------------------\n\ninstruction to js_escape using text:\n    set js_out to \"\"\n    set js_i to 1\n\n    as long as js_i <= length of text, do:\n        set js_char to substring of text from js_i to js_i\n\n        if js_char is \"\\\"\", then do:\n            set js_out to js_out, then \"\\\\\\\"\"\n        but if js_char is \"\\\\\", then do:\n            set js_out to js_out, then \"\\\\\\\\\"\n        but if js_char is \"\\n\", then do:\n            set js_out to js_out, then \"\\\\n\"\n        but if js_char is \"\\r\", then do:\n            set js_out to js_out, then \"\\\\r\"\n        but if js_char is \"\\t\", then do:\n            set js_out to js_out, then \"\\\\t\"\n        but if js_char is \"\\b\", then do:\n            set js_out to js_out, then \"\\\\b\"\n        but if js_char is \"\\f\", then do:\n            set js_out to js_out, then \"\\\\f\"\n        but if js_char is \"\\a\", then do:\n            set js_out to js_out, then \"\\\\u0007\"\n        but if js_char is \"\\v\", then do:\n            set js_out to js_out, then \"\\\\u000b\"\n        but if js_char is \"\\0\", then do:\n            set js_out to js_out, then \"\\\\u0000\"\n        but if js_char is \"\\e\", then do:\n            set js_out to js_out, then \"\\\\u001b\"\n        anything else do:\n            set js_out to js_out, then js_char\n        end if\n\n        change js_i by 1\n    end as long as\n\n    give back js_out\nend instruction\n\ninstruction to js_encode_string using val:\n    if val is not a list, then do:\n        call js_fail with \"Invalid tagged string\"\n    end if\n\n    if length of val is not 2, then do:\n        call js_fail with \"Invalid tagged string structure\"\n    end if\n\n    if val[1] is not \"__str__\", then do:\n        call js_fail with \"Expected tagged string\"\n    end if\n\n    set js_segments to val[2]\n\n    if js_segments is not a list, then do:\n        call js_fail with \"Invalid string segments\"\n    end if\n\n    set js_out to \"\\\"\"\n    set js_i to 1\n\n    as long as js_i <= length of js_segments, do:\n        set js_segment to js_segments[js_i]\n\n        if js_segment is not a list, then do:\n            call js_fail with \"Invalid string segment\"\n        end if\n        if length of js_segment is not 2, then do:\n            call js_fail with \"Invalid string segment length\"\n        end if\n\n        if js_segment[1] is \"__text__\", then do:\n            if js_segment[2] is a string, then do:\n                set js_out to js_out, then call js_escape with js_segment[2]\n            anything else do:\n                call js_fail with \"Invalid text segment payload\"\n            end if\n\n        but if js_segment[1] is \"__u16__\", then do:\n            if length of js_segment[2] is not 4, then do:\n                call js_fail with \"Invalid Unicode segment length\"\n            end if\n\n            set js_u to 1\n            as long as js_u <= 4, do:\n                if call js_hex_digit with substring of js_segment[2] from js_u to js_u is 0, then do:\n                    call js_fail with \"Invalid Unicode escape sequence\"\n                end if\n                change js_u by 1\n            end as long as\n\n            set js_out to js_out, then \"\\\\u\", then js_segment[2]\n\n        anything else do:\n            call js_fail with \"Unknown string segment\"\n        end if\n\n        change js_i by 1\n    end as long as\n\n    set js_out to js_out, then \"\\\"\"\n    give back js_out\nend instruction\n\n# --------------------------------------------------\n# VALUE ENCODING (1-based)\n# --------------------------------------------------\n\ninstruction to js_encode_value using val:\n    if val is a list, then do:\n        set js_len to length of val\n\n        if js_len is 0, then do:\n            give back \"[]\"\n        end if\n\n        set js_type to val[1]\n\n        if js_type is \"__str__\", then do:\n            give back call js_encode_string with val\n        end if\n\n        if js_type is \"__bool__\", then do:\n            if js_len is not 2, then do:\n                call js_fail with \"Invalid boolean representation\"\n            end if\n\n            if val[2] is 1, then do:\n                give back \"true\"\n            but if val[2] is 0, then do:\n                give back \"false\"\n            anything else do:\n                call js_fail with \"Invalid boolean representation\"\n            end if\n        end if\n\n        if js_type is \"__null__\", then do:\n            if js_len is not 1, then do:\n                call js_fail with \"Invalid null representation\"\n            end if\n            give back \"null\"\n        end if\n\n        if js_type is \"__obj__\", then do:\n            if (js_len - 1) mod 2 is not 0, then do:\n                call js_fail with \"Invalid object structure for encoding\"\n            end if\n\n            set js_out to \"{\"\n            set js_i to 2\n\n            as long as js_i <= js_len, do:\n                set js_k to val[js_i]\n                set js_v to val[js_i + 1]\n\n                set js_out to js_out, then call js_encode_string with js_k\n                set js_out to js_out, then \": \"\n                set js_out to js_out, then call js_encode_value with js_v\n\n                change js_i by 2\n\n                if js_i <= js_len, then do:\n                    set js_out to js_out, then \", \"\n                end if\n            end as long as\n\n            set js_out to js_out, then \"}\"\n            give back js_out\n        end if\n\n        if js_type is \"__arr__\", then do:\n            set js_out to \"[\"\n            set js_i to 2\n\n            as long as js_i <= js_len, do:\n                set js_out to js_out, then call js_encode_value with val[js_i]\n                change js_i by 1\n\n                if js_i <= js_len, then do:\n                    set js_out to js_out, then \", \"\n                end if\n            end as long as\n\n            set js_out to js_out, then \"]\"\n            give back js_out\n        end if\n\n        set js_out to \"[\"\n        set js_i to 1\n\n        as long as js_i <= js_len, do:\n            set js_out to js_out, then call js_encode_value with val[js_i]\n            change js_i by 1\n\n            if js_i <= js_len, then do:\n                set js_out to js_out, then \", \"\n            end if\n        end as long as\n\n        set js_out to js_out, then \"]\"\n        give back js_out\n    end if\n\n    if val is a number, then do:\n        give back val\n    end if\n\n    give back \"\\\"\", then call js_escape with val, then \"\\\"\"\nend instruction\n\n# --------------------------------------------------\n# PUBLIC FUNCTIONS\n# --------------------------------------------------\n\ninstruction to json_decode using raw:\n    set js_text to raw\n    set js_pos to 1\n\n    call js_skip_whitespace\n\n    if length of js_text is 0 or js_pos > length of js_text, then do:\n        call js_fail with \"Cannot decode empty JSON\"\n    end if\n\n    set js_result to call js_parse_value\n\n    call js_skip_whitespace\n\n    if js_pos <= length of js_text, then do:\n        call js_fail with \"Unexpected extra characters after JSON\"\n    end if\n\n    give back js_result\nend instruction\n\ninstruction to json_encode using val:\n    give back call js_encode_value with val\nend instruction\n"
    }
  ]
}
