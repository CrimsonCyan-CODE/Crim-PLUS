{
  "rose_format": 1,
  "name": "ui",
  "version": "1.2",
  "files": [
    {
      "name": "ui.crim",
      "source": "# ui 1.2 - interface pieces and layout helpers for Crim+\n# Use it with:   use ui\n# Example:       say labeled_bar with \"HP\" and 70 and 100 and 20\n#                (prints: HP [##############------] 70/100)\n# ui gives you three kinds of things:\n#   - text pieces for say / console games (bars, boxes, titles, menus, aligned text)\n#   - numbers for display games (bar widths, button hit-tests, even spacing, grid positions)\n#   - ready-made shapes for display games (a health bar and a clickable button). They need Crim+ 1.6 or newer,\n#     \"use display\" in your program, and \"open display\" before you show them:\n#         show_bar with 20 and 20 and 200        a bar at x 20, y 20, 200 pixels wide\n#         set_bar with hp and 100                the fill follows hp (green, then yellow, then red)\n#         hide_bar\n#         show_button with \"Play\" and 20 and 60 and 160     a button at x 20, y 60, 160 pixels wide\n#         if button_pressed is 1, then do:       gives 1 once each time it is clicked\n#         hide_button\n#     Their names are yours to use too: ui_bar_back, ui_bar_fill, ui_button_box, ui_button_text\n#     (for example: set color of ui_bar_back to \"#222222\").\n# Everything is plain ASCII so it looks right in any console.\n# Helper variables and helper instructions inside this module start with ui_ so they won't clash with yours.\n\nui_bar_back is shape, details are:\n    shape is 4 sides\n    width is 200\n    height is 16\n    position is top left\n    color is \"#2a2a3a\"\n    opacity is 0%\nend ui_bar_back details\n\nui_bar_fill is shape, details are:\n    shape is 4 sides\n    width is 200\n    height is 16\n    position is top left\n    color is green\n    opacity is 0%\nend ui_bar_fill details\n\nui_button_box is shape, details are:\n    shape is 4 sides\n    width is 160\n    height is 40\n    position is top left\n    color is \"#3a3a5a\"\n    opacity is 0%\n    when clicked, do:\n        if ui_button_on is 1, then do:\n            set ui_clicked to 1\n        end if\nend ui_button_box details\n\nui_button_text is text, details are:\n    text says ui_button_label\n    position is top left\n    size is 20\n    color is white\n    opacity is 0%\nend ui_button_text details\n\nset ui_bar_full to 200\nset ui_button_label to \"OK\"\nset ui_button_on to 0\nset ui_clicked to 0\n\ninstruction to ui_fraction using value and maximum:\n    if maximum <= 0, then do:\n        give back 0\n    end if\n    set ui_f to value / maximum\n    if ui_f < 0, then do:\n        set ui_f to 0\n    end if\n    if ui_f > 1, then do:\n        set ui_f to 1\n    end if\n    give back ui_f\nend instruction\n\ninstruction to fill_text using piece and count:\n    set ui_out to \"\"\n    set ui_n to round count\n    repeat ui_n times:\n        set ui_out to ui_out, then piece\n    end repeat\n    give back ui_out\nend instruction\n\ninstruction to bar_with using value and maximum and cells and full_char and empty_char:\n    set ui_frac to run ui_fraction using value and maximum\n    set ui_filled to round (ui_frac * cells)\n    set ui_empty to cells - ui_filled\n    set ui_a to run fill_text using full_char and ui_filled\n    set ui_b to run fill_text using empty_char and ui_empty\n    set ui_out to \"[\", then ui_a, then ui_b, then \"]\"\n    give back ui_out\nend instruction\n\ninstruction to bar using value and maximum and cells:\n    give back run bar_with using value and maximum and cells and \"#\" and \"-\"\nend instruction\n\ninstruction to percent_bar using value and maximum and cells:\n    set ui_text to run bar using value and maximum and cells\n    set ui_frac to run ui_fraction using value and maximum\n    set ui_pct to round (ui_frac * 100)\n    set ui_out to ui_text, then \" \", then ui_pct, then \"%\"\n    give back ui_out\nend instruction\n\ninstruction to labeled_bar using label and value and maximum and cells:\n    set ui_text to run bar using value and maximum and cells\n    set ui_out to label, then \" \", then ui_text, then \" \", then value, then \"/\", then maximum\n    give back ui_out\nend instruction\n\ninstruction to align_left using message and cells:\n    set ui_len to length of message\n    if ui_len >= cells, then do:\n        give back message\n    end if\n    set ui_pad to run fill_text using \" \" and cells - ui_len\n    set ui_out to message, then ui_pad\n    give back ui_out\nend instruction\n\ninstruction to align_right using message and cells:\n    set ui_len to length of message\n    if ui_len >= cells, then do:\n        give back message\n    end if\n    set ui_pad to run fill_text using \" \" and cells - ui_len\n    set ui_out to ui_pad, then message\n    give back ui_out\nend instruction\n\ninstruction to align_center using message and cells:\n    set ui_len to length of message\n    if ui_len >= cells, then do:\n        give back message\n    end if\n    set ui_total to cells - ui_len\n    set ui_before to floor (ui_total / 2)\n    set ui_after to ui_total - ui_before\n    set ui_left to run fill_text using \" \" and ui_before\n    set ui_right to run fill_text using \" \" and ui_after\n    set ui_out to ui_left, then message, then ui_right\n    give back ui_out\nend instruction\n\ninstruction to draw_line using cells:\n    set ui_out to run fill_text using \"-\" and cells\n    say ui_out\nend instruction\n\ninstruction to draw_box using message:\n    set ui_len to length of message\n    set ui_dashes to run fill_text using \"-\" and ui_len + 2\n    set ui_edge to \"+\", then ui_dashes, then \"+\"\n    say ui_edge\n    say \"| \", then message, then \" |\"\n    say ui_edge\nend instruction\n\ninstruction to draw_title using message and cells:\n    set ui_rule to run fill_text using \"=\" and cells\n    set ui_mid to run align_center using message and cells\n    say ui_rule\n    say ui_mid\n    say ui_rule\nend instruction\n\ninstruction to menu_choice using heading and options:\n    say heading\n    set ui_i to 0\n    for each ui_opt in options, do:\n        change ui_i by 1\n        say \"  \", then ui_i, then \") \", then ui_opt\n    end for each\n    set ui_count to length of options\n    set ui_ok to 0\n    as long as ui_ok is 0, do:\n        say \"Choose 1-\", then ui_count, then \":\" and wait for input, store input in ui_answer\n        if ui_answer is a number, then do:\n            if ui_answer >= 1 and ui_answer <= ui_count and ui_answer mod 1 is 0, then do:\n                set ui_ok to 1\n            end if\n        end if\n        if ui_ok is 0, then do:\n            say \"Please type a whole number from 1 to \", then ui_count, then \".\"\n        end if\n    end while\n    give back ui_answer\nend instruction\n\ninstruction to bar_percent using value and maximum:\n    set ui_frac to run ui_fraction using value and maximum\n    give back ui_frac * 100\nend instruction\n\ninstruction to bar_width using value and maximum and full_width:\n    set ui_frac to run ui_fraction using value and maximum\n    give back round (ui_frac * full_width)\nend instruction\n\ninstruction to inside_box using point_x and point_y and box_x and box_y and box_w and box_h:\n    if point_x < box_x or point_x > box_x + box_w, then do:\n        give back 0\n    end if\n    if point_y < box_y or point_y > box_y + box_h, then do:\n        give back 0\n    end if\n    give back 1\nend instruction\n\ninstruction to center_offset using container and item:\n    give back (container - item) / 2\nend instruction\n\ninstruction to spaced_position using index and count and total and item_size:\n    set ui_gap to (total - count * item_size) / (count + 1)\n    give back round (ui_gap * (index + 1) + item_size * index)\nend instruction\n\ninstruction to grid_x using index and columns and cell_w and gap:\n    give back (index mod columns) * (cell_w + gap)\nend instruction\n\ninstruction to grid_y using index and columns and cell_h and gap:\n    set ui_row to floor (index / columns)\n    give back ui_row * (cell_h + gap)\nend instruction\n\ninstruction to show_bar using left_px and top_px and bar_length:\n    set ui_bar_full to bar_length\n    set width of ui_bar_back to bar_length\n    set width of ui_bar_fill to bar_length\n    set x of ui_bar_back to left_px\n    set y of ui_bar_back to top_px\n    set x of ui_bar_fill to left_px\n    set y of ui_bar_fill to top_px\n    set opacity of ui_bar_back to 100\n    set opacity of ui_bar_fill to 100\n    display ui_bar_back\n    display ui_bar_fill\nend instruction\n\ninstruction to set_bar using value and maximum:\n    set ui_frac to run ui_fraction using value and maximum\n    set width of ui_bar_fill to round (ui_frac * ui_bar_full)\n    if ui_frac >= 0.6, then do:\n        set color of ui_bar_fill to green\n    but if ui_frac >= 0.3, then do:\n        set color of ui_bar_fill to yellow\n    anything else do:\n        set color of ui_bar_fill to red\n    end if\nend instruction\n\ninstruction to hide_bar:\n    set opacity of ui_bar_back to 0\n    set opacity of ui_bar_fill to 0\nend instruction\n\ninstruction to show_button using label and left_px and top_px and button_length:\n    set ui_button_label to label\n    set width of ui_button_box to button_length\n    set x of ui_button_box to left_px\n    set y of ui_button_box to top_px\n    set x of ui_button_text to left_px + 14\n    set y of ui_button_text to top_px + 9\n    set opacity of ui_button_box to 100\n    set opacity of ui_button_text to 100\n    set ui_button_on to 1\n    set ui_clicked to 0\n    display ui_button_box\n    display ui_button_text\nend instruction\n\ninstruction to hide_button:\n    set opacity of ui_button_box to 0\n    set opacity of ui_button_text to 0\n    set ui_button_on to 0\nend instruction\n\ninstruction to button_pressed:\n    if ui_clicked is 1, then do:\n        set ui_clicked to 0\n        give back 1\n    end if\n    give back 0\nend instruction\n"
    }
  ]
}
