{
  "rose_format": 1,
  "name": "ui",
  "version": "1.1",
  "files": [
    {
      "name": "ui.crim",
      "source": "# ui 1.1 - text-mode interface pieces and layout helpers for Crim+\n# Use it with:   use ui\n# Example:       say run labeled_bar using \"HP\" and 70 and 100 and 20\n#                (prints: HP [##############------] 70/100)\n# ui gives you two kinds of things:\n#   - text pieces for say / console games (bars, boxes, titles, menus, aligned text)\n#   - numbers for display games (bar widths, button hit-tests, even spacing, grid positions)\n# Everything is plain ASCII so it looks right in any console.\n# Helper variables and helper instructions inside this module start with ui_ so they won't clash with yours.\n\ninstruction to ui_fraction using value and maximum:\n    if maximum <= 0, then do:\n        give back 0\n    end if\n    set ui_f to value / maximum\n    if ui_f < 0, then do:\n        set ui_f to 0\n    end if\n    if ui_f > 1, then do:\n        set ui_f to 1\n    end if\n    give back ui_f\nend instruction\n\ninstruction to fill_text using piece and count:\n    set ui_out to \"\"\n    set ui_n to round count\n    repeat ui_n times:\n        set ui_out to ui_out, then piece\n    end repeat\n    give back ui_out\nend instruction\n\ninstruction to bar_with using value and maximum and cells and full_char and empty_char:\n    set ui_frac to run ui_fraction using value and maximum\n    set ui_filled to round (ui_frac * cells)\n    set ui_empty to cells - ui_filled\n    set ui_a to run fill_text using full_char and ui_filled\n    set ui_b to run fill_text using empty_char and ui_empty\n    set ui_out to \"[\", then ui_a, then ui_b, then \"]\"\n    give back ui_out\nend instruction\n\ninstruction to bar using value and maximum and cells:\n    give back run bar_with using value and maximum and cells and \"#\" and \"-\"\nend instruction\n\ninstruction to percent_bar using value and maximum and cells:\n    set ui_text to run bar using value and maximum and cells\n    set ui_frac to run ui_fraction using value and maximum\n    set ui_pct to round (ui_frac * 100)\n    set ui_out to ui_text, then \" \", then ui_pct, then \"%\"\n    give back ui_out\nend instruction\n\ninstruction to labeled_bar using label and value and maximum and cells:\n    set ui_text to run bar using value and maximum and cells\n    set ui_out to label, then \" \", then ui_text, then \" \", then value, then \"/\", then maximum\n    give back ui_out\nend instruction\n\ninstruction to align_left using message and cells:\n    set ui_len to length of message\n    if ui_len >= cells, then do:\n        give back message\n    end if\n    set ui_pad to run fill_text using \" \" and cells - ui_len\n    set ui_out to message, then ui_pad\n    give back ui_out\nend instruction\n\ninstruction to align_right using message and cells:\n    set ui_len to length of message\n    if ui_len >= cells, then do:\n        give back message\n    end if\n    set ui_pad to run fill_text using \" \" and cells - ui_len\n    set ui_out to ui_pad, then message\n    give back ui_out\nend instruction\n\ninstruction to align_center using message and cells:\n    set ui_len to length of message\n    if ui_len >= cells, then do:\n        give back message\n    end if\n    set ui_total to cells - ui_len\n    set ui_before to floor (ui_total / 2)\n    set ui_after to ui_total - ui_before\n    set ui_left to run fill_text using \" \" and ui_before\n    set ui_right to run fill_text using \" \" and ui_after\n    set ui_out to ui_left, then message, then ui_right\n    give back ui_out\nend instruction\n\ninstruction to draw_line using cells:\n    set ui_out to run fill_text using \"-\" and cells\n    say ui_out\nend instruction\n\ninstruction to draw_box using message:\n    set ui_len to length of message\n    set ui_dashes to run fill_text using \"-\" and ui_len + 2\n    set ui_edge to \"+\", then ui_dashes, then \"+\"\n    say ui_edge\n    say \"| \", then message, then \" |\"\n    say ui_edge\nend instruction\n\ninstruction to draw_title using message and cells:\n    set ui_rule to run fill_text using \"=\" and cells\n    set ui_mid to run align_center using message and cells\n    say ui_rule\n    say ui_mid\n    say ui_rule\nend instruction\n\ninstruction to menu_choice using heading and options:\n    say heading\n    set ui_i to 0\n    for each ui_opt in options, do:\n        change ui_i by 1\n        say \"  \", then ui_i, then \") \", then ui_opt\n    end for each\n    set ui_count to length of options\n    set ui_ok to 0\n    as long as ui_ok is 0, do:\n        say \"Choose 1-\", then ui_count, then \":\" and wait for input, store input in ui_answer\n        if ui_answer is a number, then do:\n            if ui_answer >= 1 and ui_answer <= ui_count and ui_answer mod 1 is 0, then do:\n                set ui_ok to 1\n            end if\n        end if\n        if ui_ok is 0, then do:\n            say \"Please type a whole number from 1 to \", then ui_count, then \".\"\n        end if\n    end while\n    give back ui_answer\nend instruction\n\ninstruction to bar_percent using value and maximum:\n    set ui_frac to run ui_fraction using value and maximum\n    give back ui_frac * 100\nend instruction\n\ninstruction to bar_width using value and maximum and full_width:\n    set ui_frac to run ui_fraction using value and maximum\n    give back round (ui_frac * full_width)\nend instruction\n\ninstruction to inside_box using point_x and point_y and box_x and box_y and box_w and box_h:\n    if point_x < box_x or point_x > box_x + box_w, then do:\n        give back 0\n    end if\n    if point_y < box_y or point_y > box_y + box_h, then do:\n        give back 0\n    end if\n    give back 1\nend instruction\n\ninstruction to center_offset using container and item:\n    give back (container - item) / 2\nend instruction\n\ninstruction to spaced_position using index and count and total and item_size:\n    set ui_gap to (total - count * item_size) / (count + 1)\n    give back round (ui_gap * (index + 1) + item_size * index)\nend instruction\n\ninstruction to grid_x using index and columns and cell_w and gap:\n    give back (index mod columns) * (cell_w + gap)\nend instruction\n\ninstruction to grid_y using index and columns and cell_h and gap:\n    set ui_row to floor (index / columns)\n    give back ui_row * (cell_h + gap)\nend instruction\n"
    }
  ]
}
