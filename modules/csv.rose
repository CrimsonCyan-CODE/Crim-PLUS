{
  "rose_format": 1,
  "name": "csv",
  "version": "1.0.0",
  "description": "Windows-first CSV parsing and exporting for Crim+ 1.5.0. Supports quoted commas, doubled quotes, multiline fields, row/cell access, and CSV escaping.",
  "files": [
    {
      "name": "csv.crim",
      "source": "# csv 1.0.0 - CSV tools for Crim+ v1.5.0\n# Windows-first CSV parser with quoted commas, doubled quotes, multiline fields,\n# row/cell access, and correctly escaped CSV export.\n# Use: use csv\n# Rows are stored as flat cells plus row lengths because Crim+ lists are flat.\n\ncsv_cells is list, details are:\n    items are []\nend csv_cells details\n\ncsv_row_lengths is list, details are:\n    items are []\nend csv_row_lengths details\n\nset csv_row_count to 0\nset csv_col_count to 0\nset csv_error to \"\"\nset csv_quote to \"\\\"\"\n\ninstruction to parse_csv using csv_text:\n    empty csv_cells\n    empty csv_row_lengths\n    set csv_row_count to 0\n    set csv_col_count to 0\n    set csv_error to \"\"\n    set csv_field to \"\"\n    set csv_field_started to 0\n    set csv_record_started to 0\n    set csv_inside_quotes to 0\n    set csv_row_length to 0\n    set csv_i to 0\n    set csv_text_length to length of csv_text\n    set csv_chars to split csv_text by \"\"\n\n    as long as csv_i < csv_text_length, do:\n        set csv_char to item csv_i of csv_chars\n        if csv_inside_quotes is 1, then do:\n            if csv_char is csv_quote, then do:\n                set csv_next_i to csv_i + 1\n                if csv_next_i < csv_text_length, then do:\n                    set csv_next_char to item csv_next_i of csv_chars\n                    if csv_next_char is csv_quote, then do:\n                        set csv_field to csv_field, then csv_quote\n                        change csv_i by 2\n                    anything else do:\n                        set csv_inside_quotes to 0\n                        change csv_i by 1\n                    end if\n                anything else do:\n                    set csv_inside_quotes to 0\n                    change csv_i by 1\n                end if\n            anything else do:\n                set csv_field to csv_field, then csv_char\n                change csv_i by 1\n            end if\n        anything else do:\n            if csv_char is csv_quote and csv_field_started is 0 and length of csv_field is 0, then do:\n                set csv_inside_quotes to 1\n                set csv_field_started to 1\n                set csv_record_started to 1\n                change csv_i by 1\n            anything else do:\n                if csv_char is \",\", then do:\n                    add csv_field to csv_cells\n                    change csv_row_length by 1\n                    set csv_field to \"\"\n                    set csv_field_started to 0\n                    set csv_record_started to 1\n                    change csv_i by 1\n                anything else do:\n                    if csv_char is \"\\n\", then do:\n                        add csv_field to csv_cells\n                        change csv_row_length by 1\n                        add csv_row_length to csv_row_lengths\n                        change csv_row_count by 1\n                        if csv_row_length > csv_col_count, then do:\n                            set csv_col_count to csv_row_length\n                        end if\n                        set csv_field to \"\"\n                        set csv_field_started to 0\n                        set csv_record_started to 0\n                        set csv_row_length to 0\n                        change csv_i by 1\n                    anything else do:\n                        set csv_field to csv_field, then csv_char\n                        set csv_field_started to 1\n                        set csv_record_started to 1\n                        change csv_i by 1\n                    end if\n                end if\n            end if\n        end if\n    end while\n\n    if csv_inside_quotes is 1, then do:\n        set csv_error to \"Unclosed quoted field\"\n    end if\n    if csv_field_started is 1 or csv_record_started is 1 or length of csv_field > 0, then do:\n        add csv_field to csv_cells\n        change csv_row_length by 1\n        add csv_row_length to csv_row_lengths\n        change csv_row_count by 1\n        if csv_row_length > csv_col_count, then do:\n            set csv_col_count to csv_row_length\n        end if\n    end if\n    give back csv_row_count\nend instruction\n\ninstruction to get_row_count:\n    give back csv_row_count\nend instruction\n\ninstruction to get_col_count:\n    give back csv_col_count\nend instruction\n\ninstruction to get_error:\n    give back csv_error\nend instruction\n\ninstruction to get_cell using row_index and col_index:\n    if row_index < 0 or row_index >= csv_row_count, then do:\n        give back \"\"\n    end if\n    set csv_row_start to 0\n    set csv_r to 0\n    as long as csv_r < row_index, do:\n        change csv_row_start by item csv_r of csv_row_lengths\n        change csv_r by 1\n    end while\n    set csv_this_row_length to item row_index of csv_row_lengths\n    if col_index < 0 or col_index >= csv_this_row_length, then do:\n        give back \"\"\n    end if\n    set csv_cell_index to csv_row_start + col_index\n    give back item csv_cell_index of csv_cells\nend instruction\n\ninstruction to csv_escape_cell using cell_text:\n    set csv_needs_quotes to 0\n    if cell_text contains \",\" or cell_text contains csv_quote, then do:\n        set csv_needs_quotes to 1\n    end if\n    set csv_newline_parts to split cell_text by \"\\n\"\n    if length of csv_newline_parts > 1, then do:\n        set csv_needs_quotes to 1\n    end if\n    if csv_needs_quotes is 0, then do:\n        give back cell_text\n    end if\n    set csv_quote_parts to split cell_text by csv_quote\n    set csv_double_quote to csv_quote, then csv_quote\n    set csv_escaped_text to join csv_quote_parts with csv_double_quote\n    set csv_escaped_text to csv_quote, then csv_escaped_text, then csv_quote\n    give back csv_escaped_text\nend instruction\n\ninstruction to get_row using row_index:\n    if row_index < 0 or row_index >= csv_row_count, then do:\n        give back \"\"\n    end if\n    set csv_row_start to 0\n    set csv_r to 0\n    as long as csv_r < row_index, do:\n        change csv_row_start by item csv_r of csv_row_lengths\n        change csv_r by 1\n    end while\n    set csv_this_row_length to item row_index of csv_row_lengths\n    set csv_row_text to \"\"\n    set csv_c to 0\n    as long as csv_c < csv_this_row_length, do:\n        if csv_c > 0, then do:\n            set csv_row_text to csv_row_text, then \",\"\n        end if\n        set csv_cell_index to csv_row_start + csv_c\n        set csv_cell_text to item csv_cell_index of csv_cells\n        set csv_row_text to csv_row_text, then csv_escape_cell with csv_cell_text\n        change csv_c by 1\n    end while\n    give back csv_row_text\nend instruction\n\ninstruction to reset_csv:\n    empty csv_cells\n    empty csv_row_lengths\n    set csv_row_count to 0\n    set csv_col_count to 0\n    set csv_error to \"\"\n    give back 1\nend instruction\n\ninstruction to to_csv:\n    set csv_output to \"\"\n    set csv_r to 0\n    as long as csv_r < csv_row_count, do:\n        if csv_r > 0, then do:\n            set csv_output to csv_output, then \"\\n\"\n        end if\n        set csv_output to csv_output, then get_row with csv_r\n        change csv_r by 1\n    end while\n    give back csv_output\nend instruction\n"
    }
  ]
}
