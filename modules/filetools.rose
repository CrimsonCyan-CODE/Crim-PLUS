  "python": [
    {
      "name": "filetools.py",
      "source": "\"\"\"filetools - look at and manage files and folders (a CrimCobra module).\n\nUse it with:   use filetools\n    set names to list_files with \"exercises\"      a list; folders end with /\n    if folder_exists with \"exercises\" is 1, then do: ...\n    set size to file_size with \"notes.txt\"        bytes\n    copy_file with \"a.txt\" and \"b.txt\"\n    move_file with \"a.txt\" and \"old/a.txt\"\n    delete_folder with \"old\"                      deletes the folder and everything in it\n    set kind to file_extension with \"photo.PNG\"   .png\n\nEverything stays inside your program's folder (or the save folder), the same safety rule as Crim+'s own file statements.\n\"\"\"\nimport os\nimport shutil\n\nimport crimcobra\n\n\ndef list_files(folder=\".\"):\n    path = crimcobra.path(folder)\n    if not os.path.isdir(path):\n        crimcobra.error(f\"'{folder}' isn't a folder.\")\n    return [name + (\"/\" if os.path.isdir(os.path.join(path, name)) else \"\") for name in sorted(os.listdir(path))]\n\n\ndef folder_exists(folder):\n    return os.path.isdir(crimcobra.path(folder))\n\n\ndef file_size(name):\n    path = crimcobra.path(name)\n    if not os.path.isfile(path):\n        crimcobra.error(f\"I can't find the file '{name}'.\")\n    return os.path.getsize(path)\n\n\ndef copy_file(source, target):\n    from_path = crimcobra.path(source)\n    if not os.path.isfile(from_path):\n        crimcobra.error(f\"I can't find the file '{source}'.\")\n    to_path = crimcobra.path(target, write=True)\n    os.makedirs(os.path.dirname(to_path) or \".\", exist_ok=True)\n    shutil.copyfile(from_path, to_path)\n\n\ndef move_file(source, target):\n    from_path = crimcobra.path(source)\n    if not os.path.isfile(from_path):\n        crimcobra.error(f\"I can't find the file '{source}'.\")\n    to_path = crimcobra.path(target, write=True)\n    os.makedirs(os.path.dirname(to_path) or \".\", exist_ok=True)\n    shutil.move(from_path, to_path)\n\n\ndef delete_folder(folder):\n    path = os.path.realpath(crimcobra.path(folder, write=True))\n    if path in (os.path.realpath(crimcobra.program_folder()), os.path.realpath(crimcobra.save_folder())):\n        crimcobra.error(\"I won't delete the program's own folder.\")\n    if not os.path.isdir(path):\n        crimcobra.error(f\"'{folder}' isn't a folder.\")\n    shutil.rmtree(path)\n\n\ndef file_extension(name):\n    return os.path.splitext(str(name))[1].lower()\n"
    }
  ]
}
