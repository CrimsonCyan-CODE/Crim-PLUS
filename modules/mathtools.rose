{
  "rose_format": 1,
  "name": "mathtools",
  "version": "1.0",
  "files": [
    {
      "name": "mathtools.crim",
      "source": "# mathtools 1.0 - extra math for Crim+\n# Use it with:   this script uses: mathtools\n# Example:       say run clamp using 15 and 0 and 10\n# (Crim+ already has abs, round, floor, ceil, sqrt, mod, ^, sum of, average of,\n#  smallest of and largest of - this module adds the rest.)\n# Helper variables inside this module all start with mt_ so they won't clash with yours.\n\ninstruction to pi:\n    give back 3.14159265358979\nend instruction\n\ninstruction to square using n:\n    give back n * n\nend instruction\n\ninstruction to cube using n:\n    give back n * n * n\nend instruction\n\ninstruction to sign using n:\n    if n > 0, then do:\n        give back 1\n    but if n < 0, then do:\n        give back -1\n    end if\n    give back 0\nend instruction\n\ninstruction to clamp using value and low and high:\n    if value < low, then do:\n        give back low\n    but if value > high, then do:\n        give back high\n    end if\n    give back value\nend instruction\n\ninstruction to lerp using start and finish and t:\n    give back start + (finish - start) * t\nend instruction\n\ninstruction to map_range using value and in_low and in_high and out_low and out_high:\n    if in_high is in_low, then do:\n        give back out_low\n    end if\n    give back out_low + (value - in_low) * (out_high - out_low) / (in_high - in_low)\nend instruction\n\ninstruction to percent using part and whole:\n    if whole is 0, then do:\n        give back 0\n    end if\n    give back part / whole * 100\nend instruction\n\ninstruction to hypot using a_side and b_side:\n    give back sqrt (a_side * a_side + b_side * b_side)\nend instruction\n\ninstruction to distance using x1 and y1 and x2 and y2:\n    set mt_dx to x2 - x1\n    set mt_dy to y2 - y1\n    give back sqrt (mt_dx * mt_dx + mt_dy * mt_dy)\nend instruction\n\ninstruction to to_radians using degrees:\n    give back degrees * 3.14159265358979 / 180\nend instruction\n\ninstruction to to_degrees using radians:\n    give back radians * 180 / 3.14159265358979\nend instruction\n\ninstruction to is_even using n:\n    if n mod 2 is 0, then do:\n        give back 1\n    end if\n    give back 0\nend instruction\n\ninstruction to is_odd using n:\n    if n mod 2 is 0, then do:\n        give back 0\n    end if\n    give back 1\nend instruction\n\ninstruction to gcd using first and second:\n    set mt_a to abs first\n    set mt_b to abs second\n    as long as mt_b > 0, do:\n        set mt_t to mt_a mod mt_b\n        set mt_a to mt_b\n        set mt_b to mt_t\n    end while\n    give back mt_a\nend instruction\n\ninstruction to lcm using first and second:\n    if first is 0 or second is 0, then do:\n        give back 0\n    end if\n    set mt_g to run gcd using first and second\n    give back abs (first * second) / mt_g\nend instruction\n\ninstruction to factorial using n:\n    set mt_result to 1\n    set mt_i to 2\n    as long as mt_i <= n, do:\n        set mt_result to mt_result * mt_i\n        change mt_i by 1\n    end while\n    give back mt_result\nend instruction\n\ninstruction to fibonacci using n:\n    set mt_a to 0\n    set mt_b to 1\n    repeat n times:\n        set mt_t to mt_a + mt_b\n        set mt_a to mt_b\n        set mt_b to mt_t\n    end repeat\n    give back mt_a\nend instruction\n\ninstruction to is_prime using n:\n    if n < 2, then do:\n        give back 0\n    end if\n    set mt_i to 2\n    as long as mt_i * mt_i <= n, do:\n        if n mod mt_i is 0, then do:\n            give back 0\n        end if\n        change mt_i by 1\n    end while\n    give back 1\nend instruction\n"
    }
  ]
}
