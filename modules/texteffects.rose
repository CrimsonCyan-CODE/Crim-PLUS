{
  "rose_format": 1,
  "name": "texteffects",
  "version": "1.0",
  "files": [
    {
      "name": "texteffects.crim",
      "source": "# texteffects 1.0 - decorative text and terminal color helpers for Crim+\n# Use with: this script uses: texteffects\n# This module complements texttools; it focuses on visual output and formatting.\n# Helper variables use the te_ prefix.\n\ninstruction to rainbow_color using index:\n    set te_index to abs index mod 7\n    if te_index is 0, then do:\n        give back \"red\"\n    but if te_index is 1, then do:\n        give back \"orange\"\n    but if te_index is 2, then do:\n        give back \"yellow\"\n    but if te_index is 3, then do:\n        give back \"green\"\n    but if te_index is 4, then do:\n        give back \"blue\"\n    but if te_index is 5, then do:\n        give back \"indigo\"\n    end if\n    give back \"violet\"\nend instruction\n\ninstruction to pastel_color using index:\n    set te_index to abs index mod 7\n    if te_index is 0, then do:\n        give back \"pink\"\n    but if te_index is 1, then do:\n        give back \"peach\"\n    but if te_index is 2, then do:\n        give back \"khaki\"\n    but if te_index is 3, then do:\n        give back \"mint\"\n    but if te_index is 4, then do:\n        give back \"skyblue\"\n    but if te_index is 5, then do:\n        give back \"lavender\"\n    end if\n    give back \"plum\"\nend instruction\n\ninstruction to random_color:\n    set te_pick to random number between 0 and 6\n    give back run rainbow_color using te_pick\nend instruction\n\ninstruction to random_pastel_color:\n    set te_pick to random number between 0 and 6\n    give back run pastel_color using te_pick\nend instruction\n\ninstruction to say_in_color using phrase and color:\n    say phrase in color\nend instruction\n\ninstruction to say_random_color using phrase:\n    set color to run random_color\n    say phrase in color\nend instruction\n\ninstruction to say_rainbow_color using phrase and index:\n    set color to run rainbow_color using index\n    say phrase in color\nend instruction\n\ninstruction to repeat_symbol using symbol and count:\n    set te_out to \"\"\n    set te_i to 0\n    as long as te_i < count, do:\n        set te_out to te_out, then symbol\n        change te_i by 1\n    end while\n    give back te_out\nend instruction\n\ninstruction to separator_line using width and symbol:\n    if width <= 0, then do:\n        give back \"\"\n    end if\n    give back run repeat_symbol using symbol and width\nend instruction\n\ninstruction to box_text using phrase:\n    set te_width to length of phrase\n    set te_rule to run repeat_symbol using \"─\" and te_width + 2\n    set te_top to \"┌\", then te_rule, then \"┐\"\n    set te_middle to \"│ \", then phrase, then \" │\"\n    set te_bottom to \"└\", then te_rule, then \"┘\"\n    set te_out to te_top, then \"\\n\", then te_middle, then \"\\n\", then te_bottom\n    give back te_out\nend instruction\n\ninstruction to banner_text using phrase and symbol:\n    set te_len to length of phrase\n    set te_width to te_len + 4\n    set te_rule to run repeat_symbol using symbol and te_width\n    set te_middle to symbol, then \" \", then phrase, then \" \", then symbol\n    set te_out to te_rule, then \"\\n\", then te_middle, then \"\\n\", then te_rule\n    give back te_out\nend instruction\n\ninstruction to bracket_text using phrase and left and right:\n    set te_out to left, then phrase, then right\n    give back te_out\nend instruction\n\ninstruction to quote_text using phrase:\n    set te_out to \"“\", then phrase, then \"”\"\n    give back te_out\nend instruction\n\ninstruction to indent_text using phrase and amount:\n    if amount <= 0, then do:\n        give back phrase\n    end if\n    set te_prefix to run repeat_symbol using \" \" and amount\n    set te_out to te_prefix, then phrase\n    give back te_out\nend instruction\n\ninstruction to progress_bar using value and maximum and width and filled and empty:\n    if width <= 0, then do:\n        give back \"\"\n    end if\n    if maximum <= 0, then do:\n        set te_done to 0\n    anything else, do:\n        set te_ratio to value / maximum\n        if te_ratio < 0, then do:\n            set te_ratio to 0\n        end if\n        if te_ratio > 1, then do:\n            set te_ratio to 1\n        end if\n        set te_done to floor (te_ratio * width)\n    end if\n    set te_bar to \"\"\n    set te_i to 0\n    as long as te_i < width, do:\n        if te_i < te_done, then do:\n            set te_bar to te_bar, then filled\n        anything else, do:\n            set te_bar to te_bar, then empty\n        end if\n        change te_i by 1\n    end while\n    give back te_bar\nend instruction\n\ninstruction to loading_bar using value and maximum and width:\n    set te_inner to run progress_bar using value and maximum and width and \"█\" and \"░\"\n    set te_out to \"[\", then te_inner, then \"]\"\n    give back te_out\nend instruction\n\ninstruction to percent_bar using value and maximum and width:\n    if maximum <= 0, then do:\n        set te_percent to 0\n    anything else, do:\n        set te_percent to round (value / maximum * 100)\n        if te_percent < 0, then do:\n            set te_percent to 0\n        end if\n        if te_percent > 100, then do:\n            set te_percent to 100\n        end if\n    end if\n    set te_bar to run loading_bar using value and maximum and width\n    set te_out to te_percent, then \"% \", then te_bar\n    give back te_out\nend instruction\n\ninstruction to say_box using phrase:\n    say run box_text using phrase\nend instruction\n\ninstruction to say_banner using phrase and symbol:\n    say run banner_text using phrase and symbol\nend instruction\n\ninstruction to say_progress using value and maximum and width:\n    say run percent_bar using value and maximum and width\nend instruction\n\ninstruction to alternating_case using phrase:\n    set te_chars to split phrase by \"\"\n    set te_out to \"\"\n    set te_i to 0\n    as long as te_i < length of te_chars, do:\n        if te_i mod 2 is 0, then do:\n            set te_out to te_out, then uppercase of te_chars[te_i]\n        anything else, do:\n            set te_out to te_out, then lowercase of te_chars[te_i]\n        end if\n        change te_i by 1\n    end while\n    give back te_out\nend instruction\n\ninstruction to random_case_text using phrase:\n    set te_chars to split phrase by \"\"\n    set te_out to \"\"\n    set te_i to 0\n    as long as te_i < length of te_chars, do:\n        set te_pick to random number between 0 and 1\n        if te_pick is 0, then do:\n            set te_out to te_out, then lowercase of te_chars[te_i]\n        anything else, do:\n            set te_out to te_out, then uppercase of te_chars[te_i]\n        end if\n        change te_i by 1\n    end while\n    give back te_out\nend instruction\n"
    }
  ]
}
